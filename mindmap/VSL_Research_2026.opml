<?xml version="1.0" encoding="UTF-8"?>
<opml version="1.0">
    <head>
        <title>NCKH 2026: Transformer VSL Recognition</title>
    </head>
    <body>
        <outline text="🧠 NCKH 2026: Transformer VSL Recognition">
            
            <outline text="🎯 1. Mục tiêu &amp; Tính năng chính">
                <outline text="Mục tiêu tổng quát">
                    <outline text="App nhận diện ký hiệu VSL bằng camera" />
                    <outline text="Hiển thị văn bản/âm thanh (TTS)" />
                    <outline text="Quản lý dữ liệu &amp; Lịch sử người dùng" />
                    <outline text="Giao diện quản trị cập nhật từ điển" />
                </outline>
                <outline text="Tính năng cốt lõi">
                    <outline text="Quay &amp; Trích xuất Keypoints (MediaPipe)" />
                    <outline text="Inference TFLite thời gian thực (Offline)" />
                    <outline text="Lưu &amp; Quản lý phiên (Export/Xóa)" />
                    <outline text="Công cụ Feedback/Annotation cải thiện dataset" />
                    <outline text="Admin Dashboard: Quản lý dataset, model, metrics" />
                </outline>
            </outline>

            <outline text="👥 2. Chức năng chi tiết">
                <outline text="👤 Signer (Người ký)">
                    <outline text="Quay ký hiệu trực tiếp">
                        <outline text="Màn hình: Camera + Overlay khung xương" />
                        <outline text="Nút: Ghi / Dừng" />
                        <outline text="Lưu: Video gốc + File Keypoints JSON" />
                        <outline text="Metadata: SessionID, DeviceModel" />
                    </outline>
                    <outline text="Nhận dạng thời gian thực">
                        <outline text="Core: TFLite inference offline" />
                        <outline text="Output: PredictedText + ConfidenceScore" />
                        <outline text="Action: Nút Phát âm (TTS)" />
                        <outline text="KPI: Latency ≤ 500 ms" />
                    </outline>
                    <outline text="Lịch sử phiên">
                        <outline text="Danh sách phiên, xem lại video" />
                        <outline text="Export JSON / Xóa phiên (Owner)" />
                    </outline>
                    <outline text="Gợi ý sửa tư thế">
                        <outline text="So sánh keypoints với mẫu chuẩn" />
                        <outline text="Cảnh báo &amp; Overlay màu khớp sai" />
                        <outline text="KPI: Giảm lỗi tư thế 30% sau 3 lần" />
                    </outline>
                    <outline text="Gửi phản hồi">
                        <outline text="Form sửa nhãn, gửi mẫu cho annotator" />
                        <outline text="Trạng thái: Pending" />
                    </outline>
                </outline>
                <outline text="👀 Viewer (Người nghe)">
                    <outline text="Xem kết quả Signer">
                        <outline text="Text lớn, Phụ đề, Âm thanh" />
                        <outline text="Chia sẻ phiên qua Link" />
                    </outline>
                    <outline text="Tra cứu (Text → Sign)">
                        <outline text="Input Text → Video ký hiệu / Avatar" />
                        <outline text="KPI: Mapping đúng ≥ 90%" />
                    </outline>
                    <outline text="Feedback: Rating 1-5 sao, báo lỗi" />
                </outline>
                <outline text="🛡️ Admin / Nghiên cứu viên">
                    <outline text="Quản lý User: Gán role, Custom claims, Audit logs" />
                    <outline text="Quản lý Từ điển VSL: Upload video, Label versioning, QA Preview" />
                    <outline text="Quản lý Dataset: Duyệt Feedback, Chỉnh keypoints, Batch annotation" />
                    <outline text="Quản lý Model: Upload Artifacts, Trigger Training, Canary Deploy" />
                    <outline text="Báo cáo: Accuracy, Confusion Matrix, Latency" />
                </outline>
            </outline>

            <outline text="🏗️ 3. Kiến trúc hệ thống">
                <outline text="📱 Frontend (Mobile)">
                    <outline text="Framework: Flutter (Android-first)" />
                    <outline text="State Mgt: Riverpod hoặc Bloc" />
                    <outline text="Plugins: Camera, permission_handler, flutter_tts" />
                </outline>
                <outline text="🧠 AI Processing">
                    <outline text="Pose Extraction: MediaPipe (Client-side/Native)" />
                    <outline text="Inference: TFLite (Transformer Encoder) Offline" />
                    <outline text="Optimization: Quantized Model (int8/float16)" />
                </outline>
                <outline text="☁️ Backend (Firebase)">
                    <outline text="Auth: Xác thực người dùng" />
                    <outline text="Firestore: Metadata, Logs, Model Versions" />
                    <outline text="Storage: Video, Keypoints, Artifacts" />
                    <outline text="Functions: Post-upload, Trigger Training" />
                </outline>
                <outline text="🔄 CI / Training Pipeline">
                    <outline text="Training: Server GPU (PyTorch/TF)" />
                    <outline text="Process: Version dataset → Export Model → Convert TFLite" />
                    <outline text="Deploy: Upload Storage → Update Firestore Version" />
                    <outline text="Monitoring: Analytics + Crashlytics + Custom Metrics" />
                </outline>
            </outline>

            <outline text="🗄️ 4. Firestore Schema &amp; Data">
                <outline text="Collections Chính">
                    <outline text="users: { userId, name, role, email, createdAt }" />
                    <outline text="sessions: { sessionId, userId, recordingUrl, keypointsUrl, predictedText, confidenceScore, modelVersion, latency, device, createdAt }" />
                    <outline text="recordings: { recordingId, sessionId, storagePath, thumbnailUrl, duration }" />
                    <outline text="labels: { labelId, text, videoUrl, version, createdBy, createdAt }" />
                    <outline text="feedbacks: { feedbackId, sessionId, userId, type, comment, status }" />
                    <outline text="model_versions: { versionId, semanticVersion, artifactUrl, metrics, createdAt, notes }" />
                    <outline text="annotations: { annotationId, recordingId, labelId, annotatorId, status }" />
                </outline>
                <outline text="Metadata Bắt buộc">
                    <outline text="sessionId, userId, deviceModel" />
                    <outline text="modelVersion, inferenceLatency" />
                    <outline text="confidenceScore, fps, createdAt" />
                </outline>
            </outline>

            <outline text="🔒 5. Bảo mật &amp; Quy trình">
                <outline text="Security Rules">
                    <outline text="Delete: Chỉ Owner hoặc Admin xóa session/recording" />
                    <outline text="Update: Annotator update cần Admin approve" />
                    <outline text="Upload Model: Chỉ Role Researcher/Admin" />
                </outline>
                <outline text="Storage Paths">
                    <outline text="recordings/{userId}/{sessionId}.mp4" />
                    <outline text="keypoints/{userId}/{sessionId}.json" />
                    <outline text="dictionary/{labelId}/{version}/{video}.mp4" />
                </outline>
                <outline text="Versioning Strategy">
                    <outline text="Semantic Versioning cho Labels &amp; Models" />
                    <outline text="Client gửi modelVersion trong metadata log" />
                </outline>
            </outline>

            <outline text="🚀 6. Triển khai &amp; Phân công">
                <outline text="✅ Checklist MVP (Android-first)">
                    <outline text="Setup Project: Flutter + Firebase (google-services.json)" />
                    <outline text="Core: Camera + MediaPipe Overlay + Upload" />
                    <outline text="AI: TFLite Offline + TTS" />
                    <outline text="UI: Lịch sử, Feedback Form" />
                    <outline text="Test: Security Rules (Emulator), Benchmark Latency" />
                </outline>
                <outline text="⚠️ Lưu ý quan trọng">
                    <outline text="Chuẩn hóa Schema trước khi Dev" />
                    <outline text="Cố định version dependency (pubspec.lock)" />
                    <outline text="Thiết kế Offline Fallback (Queue upload)" />
                    <outline text="Quantize Model cho thiết bị yếu" />
                </outline>
                <outline text="🤝 Phân công nhiệm vụ">
                    <outline text="Vũ Tín">
                        <outline text="Native MediaPipe Integration" />
                        <outline text="Flutter UI Development" />
                    </outline>
                    <outline text="Phước Nghi">
                        <outline text="Backend Cloud Functions" />
                        <outline text="Chuẩn bị Dataset" />
                    </outline>
                </outline>
            </outline>
        </outline>
    </body>
</opml>